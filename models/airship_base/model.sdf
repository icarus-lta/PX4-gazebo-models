<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generic airship base body: hull, gondola, tail and sensors; propulsion is
  added by wrapper models. Neutrally buoyant in the lta world, whose Buoyancy
  plugin sets the fluid density and must name this model to reach it: the
  collision volumes total 40 m^3, so lift at 1.225 kg/m^3 is exactly the
  declared 49 kg total (hull 9.50 + fins 2.50 + gondola 36 + pods/props 1).
  The hull is one prolate spheroid of fineness 4.2, 10.97 x 2.61 m, drawn and
  collided alike: its 39.2 m^3 is what the buoyancy, the added mass, the Munk
  moment, the drag reference and the tail are all sized on. The gondola's top
  meets the envelope: along its centre line it sits 3.6 to 5.6 cm inside, and
  its long edges 0.7 to 2.8 cm below it. The centre of mass (0.007, 0, 0.8169)
  m sits under the centre of volume (0.007, 0, 2.017), 4.4 mm above the pods'
  plane.

  The tail is a sizing, not a drawing: a cruciform of 1.20 m chord, trailing
  edge 0.30 m short of the stern at x = -5.186, roots on the hull at the
  mid-chord radius 0.717 m. The ventral fin is 1.28 m, what the ground allows
  at level attitude: its tip is 5 cm above the gondola floor, which 0.6 deg of
  nose-up on the ground uses up. The fins have no collision, so the simulation
  never touches; a vehicle built to this needs a stated ground pitch. The
  dorsal and side fins are 1.52 m, the shortest that meets the requirement
  (NACA Report 184): the dorsal and ventral fins restore at least 1.2 x the
  hull's potential-flow Munk moment at every speed, judged at zero sideslip on
  the attached-flow slope (Helmbold's) times the slender-body carryover of
  NACA Report 1307: 45.8 against 38.0 N m per (m/s)^2 of u v, a ratio of 1.20.
  The plugins carry the flat-plate slope 2 pi AR / (AR + 2) that Ananda,
  Sukumar and Selig (2015) measured, a secant to about 10 deg that includes
  vortex lift (1.41 on it). The side fins make pitch stable at every speed
  (1.34 on the same basis) with the pendulum on top. A fin stalls where its
  own incidence, the body angle times the hull's upwash K_W(B), reaches the
  plates' CLmax of 0.7 (9.0 deg of body angle), and the flaps of airship_fixed
  travel +-11 deg, the most that keeps a full-rudder turn on the added-mass
  plants 2 deg below that. The margin rests on the 0.7: at the 0.55 bottom of
  the measured range the same turn is at 98 % of the stall. Here the fins are
  visual only, in the inertia at 0.36 kg/m^2; airship_*_fin gives them lift
  and airship_fixed gives them flaps. A box on a tapering stern sits inside
  the hull at the leading edge and off it at the trailing edge. The gondola
  sits 0.328 m forward so that the fins' mass leaves the centre of mass under
  the centre of volume. Added mass is not modeled here: airship_base_am is
  this file plus the <fluid_added_mass> block, and
  airship_vectored_independent_drag adds hull drag and rotational damping.
-->
<sdf version="1.10">
  <model name="airship_base">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- Hull as a solid spheroid (9.4971 kg at the hull centre), gondola
             box (36 kg at x 0.3277), four fin plates at their centres (dorsal
             and side 0.6514 kg, ventral 0.5486 kg), parallel-axis about the
             combined CoM, products included; pods/props carry their own mass
             in the wrapper, on the pods' plane. -->
        <pose>0.0067 0.0000 0.8170 0 0 0</pose>
        <mass>48.0</mass>
        <inertia>
          <ixx>41.0847</ixx>
          <iyy>151.4753</iyy>
          <izz>126.8963</izz>
          <ixy>0.0000</ixy>
          <ixz>20.0700</ixz>
          <iyz>0.0000</iyz>
        </inertia>
      </inertial>
      <!-- The hull, drawn and collided alike; buoyancy volume 39.2 m^3 -->
      <collision name="hull_collision">
        <pose>0 0 2.05 0 0 0</pose>
        <geometry>
          <ellipsoid>
            <radii>5.48570 1.30612 1.30612</radii>
          </ellipsoid>
        </geometry>
      </collision>
      <!-- Ground contact; buoyancy volume 0.8 m^3 -->
      <collision name="gondola_collision">
        <pose>0.3277 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>1.25 0.8 0.8</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name="hull_visual">
        <pose>0 0 2.05 0 0 0</pose>
        <geometry>
          <ellipsoid>
            <radii>5.48570 1.30612 1.30612</radii>
          </ellipsoid>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.9 1</ambient>
          <diffuse>0.85 0.85 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="gondola_visual">
        <pose>0.3277 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>1.25 0.8 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- Cruciform tail, visual only here: no collision and no lift-drag,
           so it adds no weathercock stiffness. The _fin variants give these
           four boxes lift and airship_fixed gives them flaps. Rooted at the
           mid-chord hull radius; see the header. -->
      <visual name="fin_port_visual">
        <pose>-4.5857 1.4768 2.0500 0 0 0</pose>
        <geometry>
          <box>
            <size>1.20 1.52 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_starboard_visual">
        <pose>-4.5857 -1.4768 2.0500 0 0 0</pose>
        <geometry>
          <box>
            <size>1.20 1.52 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_top_visual">
        <pose>-4.5857 0.0000 3.5268 0 0 0</pose>
        <geometry>
          <box>
            <size>1.20 0.03 1.52</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_bottom_visual">
        <pose>-4.5857 0.0000 0.6932 0 0 0</pose>
        <geometry>
          <box>
            <size>1.20 0.03 1.28</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653, 0.05 deg/s in rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653, 0.65/0.70 mg-rms in m/s^2 -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
  </model>
</sdf>
