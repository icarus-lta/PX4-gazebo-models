<?xml version="1.0" encoding="UTF-8"?>
<!--
  airship_base with the hull's fluid added mass. A full copy of that file
  rather than a merge include of it, because <fluid_added_mass> is a property
  of base_link's <inertial>, and a merge include can only add elements to a
  model, never modify a link it already defines. The body, its mass budget,
  the tail sizing and the gondola offset are documented in airship_base's
  header. This file differs from it by the <fluid_added_mass> block, its
  model name and this header, and variant_check.py holds it to that. The _am
  members of the generic vehicles merge this instead of airship_base.
-->
<sdf version="1.10">
  <model name="airship_base_am">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- Hull as a solid ellipsoid (10.0 kg at the hull centre), gondola
             box (36 kg at x 0.247), four fin plates (0.5 kg each at their
             centres), parallel-axis about the combined CoM, products
             included; pods/props carry their own mass in the wrapper, on
             the CoM plane. -->
        <pose>-0.0002 0.0000 0.8125 0 0 0</pose>
        <mass>48.0</mass>
        <inertia>
          <ixx>38.6349</ixx>
          <iyy>133.3492</iyy>
          <izz>108.8467</izz>
          <ixy>0.0000</ixy>
          <ixz>14.6817</ixz>
          <iyz>0.0000</iyz>
        </inertia>
        <!-- Fluid added mass of the hull: Lamb's prolate-spheroid values for
             the drawn hull's fineness ratio a/b = 4.2 (the buoyancy collision
             is a box of the same volume class and has no fineness): k1 0.07607
             axial, k2 0.86795 transverse, k' 0.62949 rotational, on the displaced
             mass rho V = 42.0924 kg of the 5.25 x 1.25 m ellipsoid and its
             transverse inertia rho V (a^2 + b^2) / 5 = 245.1884 kg m^2. Written
             about the link origin, h = 2.05 m below the hull axis, with the
             offset terms that implies (xq = h m_x, yp = -h m_y, pp = h^2 m_y,
             qq = I_q + h^2 m_x; T = 1/2 v_P^T A v_P with v_P = v_O + w x d).
             The engine folds this into the spatial inertia, Coriolis terms and
             all, so it brings the Munk moment with it: -(m_y - m_x) u v =
             -33.332 u v N m of yaw in this y-port, z-up frame, the nose turning
             away from the velocity. That is what the fins of the _fin
             members are sized against. -->
        <fluid_added_mass>
          <xx>3.20201</xx>
          <yy>36.53407</yy>
          <zz>36.53407</zz>
          <xq>6.56412</xq>
          <yp>-74.89484</yp>
          <pp>153.53443</pp>
          <qq>167.80040</qq>
          <rr>154.34394</rr>
        </fluid_added_mass>
      </inertial>
      <!-- Buoyancy volume 39.2 m^3 -->
      <collision name="hull_collision">
        <pose>0 0 2.05 0 0 0</pose>
        <geometry>
          <box>
            <size>9.8 2 2</size>
          </box>
        </geometry>
      </collision>
      <!-- Ground contact; buoyancy volume 0.8 m^3 -->
      <collision name="gondola_collision">
        <pose>0.247 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>1.25 0.8 0.8</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name="hull_visual">
        <pose>0 0 2.05 0 0 0</pose>
        <geometry>
          <ellipsoid>
            <radii>5.25 1.25 1.25</radii>
          </ellipsoid>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.9 1</ambient>
          <diffuse>0.85 0.85 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="gondola_visual">
        <pose>0.247 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>1.25 0.8 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- Cruciform tail, visual only here: no collision and no lift-drag,
           so it adds no weathercock stiffness. The _fin variants give these
           four boxes lift and airship_fixed gives them flaps. Rooted at the
           mid-chord hull radius; see the header. -->
      <visual name="fin_port_visual">
        <pose>-4.450 1.363 2.050 0 0 0</pose>
        <geometry>
          <box>
            <size>1.00 1.40 0.03</size>
          </box>
        </geometry>
        <material>
        </material>
      </visual>
      <visual name="fin_starboard_visual">
        <pose>-4.450 -1.363 2.050 0 0 0</pose>
        <geometry>
          <box>
            <size>1.00 1.40 0.03</size>
          </box>
        </geometry>
        <material>
        </material>
      </visual>
      <visual name="fin_top_visual">
        <pose>-4.450 0.000 3.413 0 0 0</pose>
        <geometry>
          <box>
            <size>1.00 0.03 1.40</size>
          </box>
        </geometry>
        <material>
        </material>
      </visual>
      <visual name="fin_bottom_visual">
        <pose>-4.450 0.000 0.687 0 0 0</pose>
        <geometry>
          <box>
            <size>1.00 0.03 1.40</size>
          </box>
        </geometry>
        <material>
        </material>
      </visual>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653, 0.05 deg/s in rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653, 0.65/0.70 mg-rms in m/s^2 -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
  </model>
</sdf>
