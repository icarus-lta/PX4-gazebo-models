<?xml version="1.0"?>
<model>
  <name>airship</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Hyunduk Shin</name>
    <email>hyunduk@icarus-airship.com</email>
  </author>
  <description>Generic airship with vectored side propulsion (current increment: propellers fixed forward at tilt 0): two propellers on a transverse rod through the center of mass. Merge-includes airship_base (10.5 m x 2.5 m hull, gondola, tail, sensors, buoyancy-neutral 49 kg). Thrust line through the CoM - no thrust-pitch coupling. Earlier gondola- and flank-mounted variants live in git history.</description>
</model>
