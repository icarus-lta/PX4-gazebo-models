<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generic airship - vectored side propulsion (fixed-tilt increment).
  ==================================================================
  Two propellers on a transverse rod whose axis passes through the
  CENTER OF MASS (rod-through-CoG layout; the mounting rod is not
  modeled). The target configuration vectors each propeller
  independently about the rod (y) axis; the current increment models
  the geometry only - propellers fixed forward at tilt = 0. Tilt
  joints and their controllers arrive in the next increment.

  THRUST GEOMETRY AND ITS SIGNATURE
    Props at z = 0.90 = CoM height and x = 0 = CoM station: the thrust
    moment arm about the CoM is zero, so forward thrust produces NO
    pitch response and no thrust-induced climb or descent - by design.
    Validated against the flank-mounted (CoV-height) layout this
    configuration replaced: identical yaw authority, thrust-pitch
    coupling 0.0853 -> 0.0004 rad. The earlier gondola- and
    flank-mounted variants live in git history.
    Lateral offsets +-1.5 m -> differential-thrust yaw -+27 N*m.

  DRIVE IT (standalone, env sourced, GZ_IP=127.0.0.1)
    gz topic -t /airship/command/motor_speed -m gz.msgs.Actuators \
      -p 'velocity: [200, 200]'          stop: -p 'velocity: [0, 0]'
    -> 2 x 8 N on 43.03 kg = 0.372 m/s^2 forward; yaw and pitch stay 0.
    Motor numbering matches the 2500 airframe: 0 = starboard, 1 = port.

  Convention reminder: MulticopterMotorModel hardcodes thrust along the
  rotor LINK's +Z and spins the joint about that Z, so each prop link is
  pitched +90 deg (link Z -> body +X) and joints use axis 0 0 1.
-->
<sdf version="1.10">
  <model name="airship">
    <include merge="true">
      <uri>model://airship_base</uri>
    </include>
    <link name="prop_starboard">
      <pose>0 -1.5 0.90 0 1.5708 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="prop_starboard_visual">
        <geometry>
          <box>
            <size>0.02 0.5 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="prop_starboard_joint" type="revolute">
      <parent>base_link</parent>
      <child>prop_starboard</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="prop_port">
      <pose>0 1.5 0.90 0 1.5708 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="prop_port_visual">
        <geometry>
          <box>
            <size>0.02 0.5 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="prop_port_joint" type="revolute">
      <parent>base_link</parent>
      <child>prop_port</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>prop_starboard_joint</jointName>
      <linkName>prop_starboard</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>300.0</maxRotVelocity>
      <motorConstant>0.0002</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>prop_port_joint</jointName>
      <linkName>prop_port</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>300.0</maxRotVelocity>
      <motorConstant>0.0002</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
