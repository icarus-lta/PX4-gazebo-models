<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generic airship - vectored side propulsion (tilt-structure increment).
  ======================================================================
  Two propellers on a transverse rod whose axis passes through the
  CENTER OF MASS (rod-through-CoG layout; the mounting rod is not
  modeled). Each propeller pod vectors independently about the rod (y)
  axis. This increment adds the tilt joints and their position
  controllers; both controllers hold tilt = 0 (thrust forward) until
  commanded, which reproduces the fixed-tilt geometry exactly.

  TILT CONVENTION AND PLACEHOLDERS
    Joint axis is 0 -1 0, so POSITIVE tilt rotates the thrust vector UP
    (0 = forward, +90 deg = straight up, +-180 deg = reverse). Range is
    currently UNLIMITED and the position controller is a soft PD -
    both are placeholders pending the vehicle's tilt-range and
    servo-rate spec; replace the joint limits and controller gains when
    those numbers arrive.

  THRUST GEOMETRY AND ITS SIGNATURE
    Pods at z = 0.8125 = CoM height and x = 0 = CoM station: the thrust
    moment arm about the CoM is zero at every tilt angle, so thrust
    produces NO pitch response - by design. At tilt 0: forward cruise
    and differential-thrust yaw (arms +-1.5 m -> -+27 N*m). Vectoring
    adds Fz (collective tilt), roll (differential tilt), and the pure
    yaw couple (0/180 deg opposition, zero net force).

  DRIVE IT (standalone, env sourced, GZ_IP=127.0.0.1)
    motors:
      gz topic -t /airship/command/motor_speed -m gz.msgs.Actuators \
        -p 'velocity: [200, 200]'          stop: -p 'velocity: [0, 0]'
      (with a PX4 instance attached, drive via px4-actuator_test
      instead - gz_bridge republishes this topic continuously and
      overrides one-shot messages within a cycle)
    tilts (radians, on the PX4-bridge servo topics; a PX4-spawned
    instance is /model/airship_0/...):
      gz topic -t /model/airship/servo_0 -m gz.msgs.Double \
        -p 'data: 1.570796326794897'
      gz topic -t /model/airship/servo_1 -m gz.msgs.Double \
        -p 'data: 1.570796326794897'
    tilts through PX4 (servo outputs 1/2; -1..1 spans -180..+180 deg,
    so 0 = forward, +0.5 = 90 deg up, +-1 = reverse):
      actuator_test set -s 1 -v 0.5 -t 10
    Motor numbering matches the 2500 airframe: 0 = starboard, 1 = port.

  Convention reminder: MulticopterMotorModel hardcodes thrust along the
  rotor LINK's +Z and spins the joint about that Z, so each prop link is
  pitched +90 deg (link Z -> body +X; written with pose degrees="true"
  so the quarter-turn is EXACT - no truncated pi in the geometry) and
  spin joints use axis 0 0 1.
  Mass bookkeeping: pod 0.4 + prop 0.1 = 0.5 kg per side, reserved in
  the base's budget, so the exact 49.000 kg neutral total holds.
-->
<sdf version="1.10">
  <model name="airship">
    <include merge="true">
      <uri>model://airship_base</uri>
    </include>
    <link name="pod_starboard">
      <pose>0 -1.5 0.8125 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="pod_starboard_visual">
        <geometry>
          <box>
            <size>0.10 0.06 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="tilt_starboard_joint" type="revolute">
      <parent>base_link</parent>
      <child>pod_starboard</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>
    <link name="prop_starboard">
      <pose degrees="true">0 -1.5 0.8125 0 90 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="prop_starboard_visual">
        <geometry>
          <box>
            <size>0.02 0.5 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="prop_starboard_joint" type="revolute">
      <parent>pod_starboard</parent>
      <child>prop_starboard</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="pod_port">
      <pose>0 1.5 0.8125 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="pod_port_visual">
        <geometry>
          <box>
            <size>0.10 0.06 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="tilt_port_joint" type="revolute">
      <parent>base_link</parent>
      <child>pod_port</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>
    <link name="prop_port">
      <pose degrees="true">0 1.5 0.8125 0 90 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="prop_port_visual">
        <geometry>
          <box>
            <size>0.02 0.5 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="prop_port_joint" type="revolute">
      <parent>pod_port</parent>
      <child>prop_port</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_starboard_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_port_joint</joint_name>
      <sub_topic>servo_1</sub_topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>prop_starboard_joint</jointName>
      <linkName>prop_starboard</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>300.0</maxRotVelocity>
      <motorConstant>0.0002</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>prop_port_joint</jointName>
      <linkName>prop_port</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>300.0</maxRotVelocity>
      <motorConstant>0.0002</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
