<?xml version="1.0" encoding="UTF-8"?>
<!--
  The vectored airship with its fins lifting. Same vehicle as
  airship_vectored_independent, which this merges: only the tail's
  aerodynamics are added, four lift-drag plugins on the fin boxes
  airship_base draws. On its own this is the fins' contribution isolated, for
  measuring; the plant the fins exist for is airship_vectored_independent_am_fin,
  where they have the Munk moment to oppose.
-->
<sdf version="1.10">
  <model name="airship_vectored_independent_fin">
    <include merge="true">
      <uri>model://airship_vectored_independent</uri>
    </include>
    <!-- The four fins as lifting surfaces, one lift-drag plugin each, on the
         planform airship_base draws and its header sizes. The
         plugin reads the velocity at <cp> (worldLinVel + worldAngVel x cp)
         and applies the force there, so no arm terms are needed.
         Basis: exposed panel 1.00 x 1.40 m, area 1.40 m^2; the two panels
         joined through the hull have AR 2.80 and the slope 2 pi AR / (AR + 2)
         = 3.665 per rad, which is what thin flat plates of AR 2-3 measure at
         this Reynolds number (Ananda, Sukumar and Selig 2015; NACA Report
         1307 asks for the experimental wing-alone slope, and Helmbold's
         3.233 fits AR 4-5 wings, not these plates); times the slender-body
         carryover K_W(B) + K_B(W) = (1 + r/s)^2 with r 0.663 (hull radius at
         the mid-chord station) and s 2.063 (root plus span), 1.746 (NACA
         1307 eqs. 14 and 21, the values it recommends for all combinations),
         so cla = 6.400 per rad on the exposed area. cp at the quarter chord
         (x = -4.20) on the span centre. <upward> is the lift direction,
         normal to the fin's plane. Drag is the plugin's linear-in-alpha form,
         cda sized to the induced drag CL^2 / (pi AR e) at 10 deg with e = 0.9.
         A rectangular plate of this aspect ratio stalls near 15 deg, so
         alpha_stall 0.3 rad (cl 1.9), falling past it to a plate's ~0.2 at
         90 deg. The fins' own added mass (about a quarter of the hull's yaw
         and pitch added inertia) is not modelled. All of it is an
         estimate with a stated basis, not a measurement. The plugin applies
         nothing when the flow at cp comes from behind (forward . v <= 0),
         so these fins are absent in reverse flight and pure lateral drift. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_port -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-4.200 1.363 2.050</cp>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <area>1.40</area>
      <a0>0</a0>
      <cla>6.400</cla>
      <cda>0.903</cda>
      <cma>0</cma>
      <alpha_stall>0.3</alpha_stall>
      <cla_stall>-1.35</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_starboard -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-4.200 -1.363 2.050</cp>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <area>1.40</area>
      <a0>0</a0>
      <cla>6.400</cla>
      <cda>0.903</cda>
      <cma>0</cma>
      <alpha_stall>0.3</alpha_stall>
      <cla_stall>-1.35</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_top -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-4.200 0.000 3.413</cp>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <area>1.40</area>
      <a0>0</a0>
      <cla>6.400</cla>
      <cda>0.903</cda>
      <cma>0</cma>
      <alpha_stall>0.3</alpha_stall>
      <cla_stall>-1.35</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_bottom -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-4.200 0.000 0.687</cp>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <area>1.40</area>
      <a0>0</a0>
      <cla>6.400</cla>
      <cda>0.903</cda>
      <cma>0</cma>
      <alpha_stall>0.3</alpha_stall>
      <cla_stall>-1.35</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
  </model>
</sdf>
