<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Cloudship with fluid added mass and its fins lifting: cloudship_am
  merged, plus the same four lift-drag plugins as cloudship_fin. This is the
  pair that belongs together. Added mass brings the Munk moment, the
  destabilising couple (m_y - m_x) u v that makes a bare hull want to fly
  sideways, and the fins are the only thing on this hull that opposes it.
  By the drawing they are a factor of eight short of it at every speed
  (0.64 against 4.92 N m per (m/s)^2 of u v, both scaling with V^2), which
  this model exists to show rather than hide.
-->
<sdf version="1.10">
  <model name="cloudship_am_fin">
    <include merge="true">
      <uri>model://cloudship_am</uri>
    </include>
    <!-- The four fins as lifting surfaces, one lift-drag plugin each. The
         plugin reads the velocity at <cp> (worldLinVel + worldAngVel x cp)
         and applies the force there (torque + cp x force), so no arm terms
         are needed and nothing here touches a link.
         Planform from the drawing: 0.465 m chord x 0.39 m span, area
         0.18135 m^2, aspect ratio 0.839, so an isolated-wing lift slope
         2 pi AR / (AR + 2) = 1.856 per rad; that is generous for a fin in a
         hull's flow and is the stated basis, not a measurement. cp at the
         quarter chord (x = -1.6475 + 0.465 / 4) on each fin's span centre.
         <upward> is the lift direction, normal to the fin's plane: y for the
         two vertical fins, z for the two horizontal ones. Drag is the
         plugin's linear-in-alpha form, cda sized to the induced drag
         CL^2 / (pi AR e) at 10 deg with e = 0.9. A plate of this aspect
         ratio does not stall like a wing: its lift keeps rising to 35-45
         deg, so alpha_stall is 0.6 rad with a gentle fall past it, and the
         post-stall drag slope puts cd near a flat plate's 1.2-1.3 at 90 deg.
         All of it is an estimate with a stated basis, not a measurement.
         One thing the plugin does that the geometry does not: it applies
         nothing when the flow at cp comes from behind (forward . v <= 0),
         so these fins are absent in reverse flight and in a pure lateral
         drift, where only the hull drag block acts. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_top -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-1.53125 0 1.6570</cp>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <area>0.18135</area>
      <a0>0</a0>
      <cla>1.856</cla>
      <cda>0.25</cda>
      <cma>0</cma>
      <alpha_stall>0.6</alpha_stall>
      <cla_stall>-0.5</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_bottom -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-1.53125 0 0.1402</cp>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <area>0.18135</area>
      <a0>0</a0>
      <cla>1.856</cla>
      <cda>0.25</cda>
      <cma>0</cma>
      <alpha_stall>0.6</alpha_stall>
      <cla_stall>-0.5</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_port -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-1.53125 0.7584 0.8986</cp>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <area>0.18135</area>
      <a0>0</a0>
      <cla>1.856</cla>
      <cda>0.25</cda>
      <cma>0</cma>
      <alpha_stall>0.6</alpha_stall>
      <cla_stall>-0.5</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_starboard -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-1.53125 -0.7584 0.8986</cp>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <area>0.18135</area>
      <a0>0</a0>
      <cla>1.856</cla>
      <cda>0.25</cda>
      <cma>0</cma>
      <alpha_stall>0.6</alpha_stall>
      <cla_stall>-0.5</cla_stall>
      <cda_stall>1.2</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
  </model>
</sdf>
