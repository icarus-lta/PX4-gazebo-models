<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lighter-than-air development world: buoyant air for airships.
  Standalone: source build/px4_sitl_default/rootfs/gz_env.sh && gz sim -r $PX4_GZ_WORLDS/lta.sdf
-->
<sdf version="1.9">
  <world name="lta">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>true</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-22 -22 14 0 0.35 0.785</camera_pose>
        <view_controller>ortho</view_controller>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
      <plugin name="Component inspector" filename="ComponentInspector"/>
      <plugin name="View angle" filename="ViewAngle"/>
    </gui>
    <!-- Declaring any world plugin replaces the entire default system list,
         so the full stack is spelled out (same pattern as underwater.sdf). -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::AirSpeed" filename="gz-sim-air-speed-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Buoyancy on the enabled links' collision volumes; PX4 spawns model
         instances with a _0 suffix. -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1.225</uniform_fluid_density>
      <enable>airship_vectored_independent::base_link</enable>
      <enable>airship_vectored_independent_0::base_link</enable>
    </plugin>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <!-- Visual-only ground markers: red = +x, green = +y, 200 m quadrant tiles. -->
    <model name="ground_markers">
      <static>true</static>
      <link name="link">
        <visual name="quadrant_pp">
          <cast_shadows>false</cast_shadows>
          <pose>100 100 0.01 0 0 0</pose>
          <geometry><box><size>200 200 0.02</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
        <visual name="quadrant_nn">
          <cast_shadows>false</cast_shadows>
          <pose>-100 -100 0.01 0 0 0</pose>
          <geometry><box><size>200 200 0.02</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
        <visual name="quadrant_pn">
          <cast_shadows>false</cast_shadows>
          <pose>100 -100 0.01 0 0 0</pose>
          <geometry><box><size>200 200 0.02</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.62 1</ambient>
            <diffuse>0.6 0.6 0.62 1</diffuse>
          </material>
        </visual>
        <visual name="quadrant_np">
          <cast_shadows>false</cast_shadows>
          <pose>-100 100 0.01 0 0 0</pose>
          <geometry><box><size>200 200 0.02</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.62 1</ambient>
            <diffuse>0.6 0.6 0.62 1</diffuse>
          </material>
        </visual>
        <visual name="axis_x_red">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>400 1.5 0.02</size></box></geometry>
          <material>
            <ambient>0.55 0.2 0.2 1</ambient>
            <diffuse>0.55 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <visual name="axis_y_green">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>1.5 400 0.02</size></box></geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Visual-only 3D reference: blue z-axis mast (rungs at 5/10/15 m) and
         two 10 m-cell wall grids behind the broadside and bow views. -->
    <model name="flight_grid">
      <static>true</static>
      <link name="link">
        <visual name="mast_z_blue">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 10 0 0 0</pose>
          <geometry><box><size>0.08 0.08 20</size></box></geometry>
          <material>
            <ambient>0.2 0.3 0.6 1</ambient>
            <diffuse>0.2 0.3 0.6 1</diffuse>
          </material>
        </visual>
        <visual name="mast_rung_5">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 5 0 0 0</pose>
          <geometry><box><size>1.0 0.08 0.08</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="mast_rung_10">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 10 0 0 0</pose>
          <geometry><box><size>1.0 0.08 0.08</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="mast_rung_15">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 15 0 0 0</pose>
          <geometry><box><size>1.0 0.08 0.08</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_v_xm30">
          <cast_shadows>false</cast_shadows>
          <pose>-30 25 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_v_xm20">
          <cast_shadows>false</cast_shadows>
          <pose>-20 25 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_v_xm10">
          <cast_shadows>false</cast_shadows>
          <pose>-10 25 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_v_x0">
          <cast_shadows>false</cast_shadows>
          <pose>0 25 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_v_xp10">
          <cast_shadows>false</cast_shadows>
          <pose>10 25 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_v_xp20">
          <cast_shadows>false</cast_shadows>
          <pose>20 25 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_v_xp30">
          <cast_shadows>false</cast_shadows>
          <pose>30 25 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_h_z10">
          <cast_shadows>false</cast_shadows>
          <pose>0 25 10 0 0 0</pose>
          <geometry><box><size>60 0.06 0.06</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_h_z20">
          <cast_shadows>false</cast_shadows>
          <pose>0 25 20 0 0 0</pose>
          <geometry><box><size>60 0.06 0.06</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_y_h_z30">
          <cast_shadows>false</cast_shadows>
          <pose>0 25 30 0 0 0</pose>
          <geometry><box><size>60 0.06 0.06</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_v_ym30">
          <cast_shadows>false</cast_shadows>
          <pose>-25 -30 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_v_ym20">
          <cast_shadows>false</cast_shadows>
          <pose>-25 -20 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_v_ym10">
          <cast_shadows>false</cast_shadows>
          <pose>-25 -10 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_v_y0">
          <cast_shadows>false</cast_shadows>
          <pose>-25 0 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_v_yp10">
          <cast_shadows>false</cast_shadows>
          <pose>-25 10 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_v_yp20">
          <cast_shadows>false</cast_shadows>
          <pose>-25 20 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_v_yp30">
          <cast_shadows>false</cast_shadows>
          <pose>-25 30 15 0 0 0</pose>
          <geometry><box><size>0.06 0.06 30</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_h_z10">
          <cast_shadows>false</cast_shadows>
          <pose>-25 0 10 0 0 0</pose>
          <geometry><box><size>0.06 60 0.06</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_h_z20">
          <cast_shadows>false</cast_shadows>
          <pose>-25 0 20 0 0 0</pose>
          <geometry><box><size>0.06 60 0.06</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_h_z30">
          <cast_shadows>false</cast_shadows>
          <pose>-25 0 30 0 0 0</pose>
          <geometry><box><size>0.06 60 0.06</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
